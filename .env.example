# Where the "Explore a 1:1" call-to-action points.
NEXT_PUBLIC_INCLARITY_BOOKING_URL="https://inclarity.space/book"

# Enables /dev/chart-debug outside of `next dev`. Leave unset in production.
ENABLE_CHART_DEBUG="false"

# Location search provider: "open-meteo" (default) or "static".
LOCATION_PROVIDER="open-meteo"
